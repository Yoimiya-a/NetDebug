<Window x:Class="NetDebug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetDebug"
        Title="局域网远程桌面"
        Width="1180" Height="780" MinWidth="880" MinHeight="560"
        Background="#FFFFFF" Foreground="#000000"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="LatencyText" Text="延迟 --" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="FpsText" Text="收帧 --" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="StatusText" Text="未连接" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <Label Content="地址"/>
          <TextBox x:Name="HostBox" Width="160" Margin="0,0,8,0" ToolTip="Ubuntu 的 IP"/>
          <Label Content="端口"/>
          <TextBox x:Name="PortBox" Width="70" Margin="0,0,8,0" Text="17611"/>
          <Label Content="密码"/>
          <PasswordBox x:Name="PasswordBox" Width="120" Margin="0,0,8,0"/>
          <Button x:Name="ConnectButton" Content="连接" Click="Connect_Click"/>
          <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
          <CheckBox x:Name="ReconnectBox" Content="断线重连" IsChecked="True" Checked="ReconnectBox_Changed" Unchecked="ReconnectBox_Changed"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,0,10,8">
      <WrapPanel VerticalAlignment="Center">
        <Label Content="编码"/>
        <ComboBox x:Name="CodecBox" SelectedIndex="0" SelectionChanged="OnSettingsChanged">
          <ComboBoxItem Content="压缩" Tag="0"/>
          <ComboBoxItem Content="不压缩" Tag="1"/>
        </ComboBox>
        <Label Content="JPEG 质量"/>
        <Slider x:Name="QualitySlider" Width="140" Minimum="1" Maximum="100" Value="30"
                VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="OnQualityChanged"/>
        <TextBlock x:Name="QualityText" Text="30" Width="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Label Content="最大宽度"/>
        <ComboBox x:Name="WidthBox" SelectedIndex="2" SelectionChanged="OnSettingsChanged">
          <ComboBoxItem Content="640" Tag="640"/>
          <ComboBoxItem Content="960" Tag="960"/>
          <ComboBoxItem Content="1280" Tag="1280"/>
          <ComboBoxItem Content="1600" Tag="1600"/>
          <ComboBoxItem Content="与桌面同宽" Tag="0"/>
        </ComboBox>
        <Label Content="帧率上限"/>
        <ComboBox x:Name="FpsBox" SelectedIndex="3" SelectionChanged="OnSettingsChanged">
          <ComboBoxItem Content="10" Tag="10"/>
          <ComboBoxItem Content="15" Tag="15"/>
          <ComboBoxItem Content="20" Tag="20"/>
          <ComboBoxItem Content="30" Tag="30"/>
        </ComboBox>
        <TextBlock x:Name="BandwidthText" Text="" Foreground="#000000" VerticalAlignment="Center"/>
        <Button x:Name="FullScreenButton" Content="全屏" Click="FullScreen_Click" Margin="12,0,0,0" ToolTip="展开画面并收起左侧目录"/>
      </WrapPanel>
    </Border>

    <Border x:Name="FilePanel" DockPanel.Dock="Left" Width="300" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
      <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="远程目录" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="OpenButton" Content="打开" DockPanel.Dock="Right" Click="Open_Click" IsEnabled="False" Margin="6,0,0,0"/>
          <TextBox x:Name="RemotePathBox" Text="未连接" ToolTip="绝对路径，回车跳转。例如 /home/ye 或 ~/Documents"
                   KeyDown="RemotePath_KeyDown" GotFocus="RemotePath_GotFocus"/>
        </DockPanel>
        <TextBlock x:Name="RemotePlaceText" DockPanel.Dock="Top" Text="" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="UpButton" Content="上级" Click="Up_Click" IsEnabled="False" Margin="0,0,6,6"/>
          <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" IsEnabled="False" Margin="0,0,6,6"/>
          <Button x:Name="UploadButton" Content="上传" Click="Upload_Click" IsEnabled="False" Margin="0,0,6,6"/>
          <Button x:Name="DownloadButton" Content="下载" Click="Download_Click" IsEnabled="False" Margin="0,0,6,6"/>
          <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" IsEnabled="False" Margin="0,0,6,6"/>
          <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="可拖入文件或文件夹。上传时也能直接选文件夹。" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <ProgressBar x:Name="TransferBar" DockPanel.Dock="Bottom" Height="8" Margin="0,8,0,0"/>
        <TextBlock x:Name="TransferText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TreeView x:Name="FileTree" BorderThickness="0" Background="#FFFFFF" Foreground="#000000"
                  AllowDrop="True" PreviewDragOver="FileTree_DragOver" Drop="FileTree_Drop"
                  MouseDoubleClick="FileTree_DoubleClick" SelectedItemChanged="FileTree_Selected"
                  KeyDown="FileTree_KeyDown">
          <TreeView.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#000000"/>
          </TreeView.Resources>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="#000000"/>
              <Setter Property="Background" Value="#FFFFFF"/>
              <Setter Property="Padding" Value="2,1"/>
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="AllowDrop" Value="True"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
              <TextBlock Foreground="#000000">
                <Run Text="{Binding Name, Mode=OneWay}"/>
                <Run Text="{Binding SizeText, Mode=OneWay}"/>
              </TextBlock>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <Grid x:Name="ScreenHost" Background="#FFFFFF" Focusable="True"
          MouseMove="Screen_MouseMove" MouseDown="Screen_MouseDown"
          MouseUp="Screen_MouseUp" MouseWheel="Screen_MouseWheel">
      <Image x:Name="ScreenImage" Stretch="Uniform" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="LowQuality"/>
      <TextBlock x:Name="HintText" Text="未连接" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#000000" FontSize="18" IsHitTestVisible="False"/>
      <TextBlock x:Name="CaptureHint" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                 Margin="10" Padding="8,4" Foreground="#000000" Background="#CCFFFFFF"
                 Text="点击画面后键盘才会发到对方，Ctrl+Alt 交回本机" Visibility="Collapsed"
                 IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</Window>
